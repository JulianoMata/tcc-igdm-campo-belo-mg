# Definir comportamento padrão para normalização de quebras de linha (LF)
* text=auto eol=lf

# Forçar tratamento estrito de texto/código fonte
*.py text eol=lf
*.ipynb text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.csv text eol=lf

# Forçar tratamento estrito de arquivos binários (impedir alteração de bytes)
*.pkl binary
*.pickle binary
*.xlsx binary
*.xls binary
*.pbix binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary